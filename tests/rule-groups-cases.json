 {
  "name": "flach ALL, beide treffen",
  "ruleSet": {
   "enabled": true,
   "logic": "all",
   "rules": [
    {
     "field": "a",
     "operator": "is",
     "value": "1"
    },
    {
     "field": "b",
     "operator": "is",
     "value": "2"
    }
   ]
  },
