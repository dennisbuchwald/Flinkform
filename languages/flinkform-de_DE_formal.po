msgstr "1 Spalte"

#: src/form-container/edit.js:648
msgid "2 columns"
msgstr "2 Spalten"

#: src/form-container/edit.js:651
msgid "Submit button style"
msgstr "Stil des Absende-Buttons"

#: src/form-container/edit.js:654
msgid "Fill"
msgstr "Gefüllt"

#: src/form-container/edit.js:655
msgid "Outline"
